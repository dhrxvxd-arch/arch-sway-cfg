configuration {
    font:                   "Iosevka Term 12";
    display-drun:           "λ";

    timeout {
        action:             "kb-cancel";
        delay:              0;
    }

    filebrowser {
        directories-first:  true;
        sorting-method:     "name";
    }
}

* {
    background:             #090909;
    foreground:             #9b8d7f;
    border-color:            #9b8d7f;
    separatorcolor:          #9b8d7f;
    spacing:                 3;

    normal-foreground:       #9b8d7f;
    normal-background:      #090909;

    active-foreground:       #9b8d7f;
    active-background:      #151515;

    urgent-foreground:       #83a598;
    urgent-background:      #090909;

    selected-normal-foreground: #9b8d7f;
    selected-normal-background: #202020;

    selected-active-foreground: #9b8d7f;
    selected-active-background: #252525;

    selected-urgent-foreground: #090909;
    selected-urgent-background: #83a598;

    alternate-normal-foreground: #9b8d7f;
    alternate-normal-background: #0e0e0e;

    alternate-active-foreground: #9b8d7f;
    alternate-active-background: #151515;

    alternate-urgent-foreground: #83a598;
    alternate-urgent-background: #0e0e0e;
}

window {
    background-color: #090909;
    border:           1px;
    border-color:     #9b8d7f;
    border-radius:    0px;
    padding:          6px;
    width:            864px;
    height:           468px;
}

mainbox {
    border:           0;
    padding:          2px;
    spacing:          4px;
}

message {
    border:           0px 0px 1px 0px;
    border-color:     #9b8d7f;
    padding:          3px;
}

textbox {
    text-color:       #9b8d7f;
}

listview {
    fixed-height:     false;
    border:           0;
    spacing:          2px;
    scrollbar:        false;
    padding:          2px 0px;
}

element {
    padding:          3px 5px;
    border-radius:    0px;
    spacing:          4px;
}

element normal.normal {
    background-color: #090909;
    text-color:       #9b8d7f;
}

element normal.urgent {
    background-color: #090909;
    text-color:       #83a598;
}

element normal.active {
    background-color: #151515;
    text-color:       #9b8d7f;
}

element selected.normal {
    background-color: #202020;
    text-color:       #9b8d7f;
}

element selected.urgent {
    background-color: #83a598;
    text-color:       #090909;
}

element selected.active {
    background-color: #252525;
    text-color:       #9b8d7f;
}

element alternate.normal {
    background-color: #0e0e0e;
    text-color:       #9b8d7f;
}

element alternate.urgent {
    background-color: #0e0e0e;
    text-color:       #83a598;
}

element alternate.active {
    background-color: #151515;
    text-color:       #9b8d7f;
}

element-text {
    highlight:        underline #83a598;
}

scrollbar {
    width:            2px;
    border:           0;
    handle-color:     #505050;
    handle-width:     2px;
    padding:          0;
}

sidebar {
    border:           0px 1px 0px 0px;
    border-color:     #9b8d7f;
}

button {
    spacing:          3px;
    text-color:       #9b8d7f;
}

button selected {
    background-color: #202020;
    text-color:       #9b8d7f;
}

inputbar {
    background-color: #111111;
    spacing:          4px;
    text-color:       #9b8d7f;
    padding:          5px;
    border:           0px 0px 1px 0px;
    border-color:     #9b8d7f;
    children:         [ prompt, textbox-prompt-colon, entry, case-indicator ];
}

case-indicator {
    spacing:          0;
    text-color:       #83a598;
}

entry {
    spacing:          0;
    text-color:       #9b8d7f;
    cursor-width:     1ch;
}

prompt {
    spacing:          0;
    text-color:       #9b8d7f;
}

textbox-prompt-colon {
    expand:           false;
    str:              "";
    margin:           0px 0.3em 0px 0px;
    text-color:       #9b8d7f;
}
